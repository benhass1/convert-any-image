{
  "name": "convert-any-image-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "check": "pnpm --dir frontend check",
    "start": "pnpm --dir frontend start",
    "dev:frontend": "pnpm --dir frontend dev",
    "build:frontend": "pnpm --dir frontend build",
    "check:frontend": "pnpm --dir frontend check",
    "dev:worker": "pnpm --dir worker dev",
    "check:worker": "pnpm --dir worker check",
    "backend:up": "docker compose -f local-backend/docker-compose.yml up --build",
    "backend:down": "docker compose -f local-backend/docker-compose.yml down --volumes"
  }
}
